#!/bin/bash
set -euxo pipefail
dnf update -y
dnf install -y python3 python3-pip awscli amazon-cloudwatch-agent
mkdir -p /opt/cloud-demo/templates
cat > /opt/cloud-demo/requirements.txt <<'REQ'
Flask==3.1.0
boto3==1.35.90
psycopg2-binary==2.9.10
gunicorn==23.0.0
REQ
cat > /opt/cloud-demo/app.py <<'PY'
import os, json, time, boto3, psycopg2
from flask import Flask, jsonify, render_template_string
app = Flask(__name__)
SECRET_ARN = os.environ["DB_SECRET_ARN"]
REGION = os.environ["AWS_REGION"]
HTML = """<!doctype html><html><head><title>AWS Cloud Demo</title>
<style>body{font-family:Arial;max-width:760px;margin:8vh auto;padding:24px}
main{border:1px solid #ddd;border-radius:14px;padding:28px}.count{font-size:3rem;font-weight:bold}</style>
</head><body><main><h1>AWS Three-Tier Cloud Application</h1>
<p>Request served by an EC2 application instance behind an Application Load Balancer.</p>
<p>Database-backed page visits:</p><div class="count">{{ count }}</div>
<p>Refresh to increment the PostgreSQL counter.</p><p>Endpoints: /health and /ready</p></main></body></html>"""
def config():
    return json.loads(boto3.client("secretsmanager", region_name=REGION).get_secret_value(SecretId=SECRET_ARN)["SecretString"])
def connect():
    c=config()
    return psycopg2.connect(host=c["host"],port=c["port"],dbname=c["dbname"],user=c["username"],
        password=c["password"],connect_timeout=5,sslmode="require")
def visit():
    error=None
    for _ in range(10):
        try:
            with connect() as db:
                with db.cursor() as cur:
                    cur.execute("CREATE TABLE IF NOT EXISTS app_visits (id INTEGER PRIMARY KEY, visit_count BIGINT NOT NULL)")
                    cur.execute("INSERT INTO app_visits VALUES (1,1) ON CONFLICT (id) DO UPDATE SET visit_count=app_visits.visit_count+1 RETURNING visit_count")
                    value=cur.fetchone()[0]
                db.commit()
            return value
        except Exception as e:
            error=e
            time.sleep(6)
    raise RuntimeError(str(error))
@app.route("/")
def home():
    try: return render_template_string(HTML,count=visit())
    except Exception as e: app.logger.exception("Database request failed"); return "Database temporarily unavailable. Check CloudWatch logs.",503
@app.route("/health")
def health(): return jsonify(status="ok"),200
@app.route("/ready")
def ready():
    try:
        with connect() as db:
            with db.cursor() as cur: cur.execute("SELECT 1")
        return jsonify(status="ready"),200
    except Exception as e: return jsonify(status="not-ready"),503
PY
python3 -m pip install --break-system-packages -r /opt/cloud-demo/requirements.txt
cat > /etc/systemd/system/cloud-demo.service <<SERVICE
[Unit]
Description=AWS Three Tier Demo Flask App
After=network-online.target
Wants=network-online.target
[Service]
User=root
WorkingDirectory=/opt/cloud-demo
Environment=DB_SECRET_ARN=${secret_arn}
Environment=AWS_REGION=${aws_region}
ExecStart=/usr/local/bin/gunicorn --bind 0.0.0.0:8080 --workers 2 app:app
Restart=always
StandardOutput=append:/var/log/cloud-demo.log
StandardError=append:/var/log/cloud-demo.log
[Install]
WantedBy=multi-user.target
SERVICE
# Locate pip-installed gunicorn if it is not in /usr/local/bin.
GUNICORN_PATH=$(python3 -c 'import shutil; print(shutil.which("gunicorn") or "/usr/local/bin/gunicorn")')
sed -i "s#ExecStart=.*#ExecStart=$GUNICORN_PATH --bind 0.0.0.0:8080 --workers 2 app:app#" /etc/systemd/system/cloud-demo.service
systemctl daemon-reload
systemctl enable --now cloud-demo
cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'CW'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/cloud-demo.log",
            "log_group_name": "${log_group}",
            "log_stream_name": "{instance_id}/application",
            "retention_in_days": 7
          }
        ]
      }
    }
  }
}
CW
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json -s || true
